APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# =====================
# AICI Platform Settings
# =====================
# Set to TRUE only if you need anyone to sign-up as student.
# For B2B school deployment, keep this FALSE and let SuperAdmin create accounts.
AICI_ALLOW_PUBLIC_REGISTRATION=false

# Optional: Shared secret code for registration. Leave empty to disable.
# If set, users must provide this code to register.
AICI_REGISTRATION_CODE=

# Default status for newly self-registered users:
# "pending" = admin must approve first, "aktif" = immediate access (not recommended)
AICI_NEW_USER_DEFAULT_STATUS=pending

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Gemini AI API Configuration (Server-side only, NOT exposed to browser)
# Get your API key from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# Registration control: set true to allow public self-registration
AICI_ALLOW_PUBLIC_REGISTRATION=false
# Optional shared secret required at registration when set
AICI_REGISTRATION_CODE=
# Status for newly registered users: pending | aktif
AICI_NEW_USER_DEFAULT_STATUS=pending